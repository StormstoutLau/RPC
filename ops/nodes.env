# B5q-1 集群 RPC 节点声明清单 (spec/cluster-bench DESIGN §3)
# C 站加入时追加节点, 空格分隔 ip:port
RPC_NODES="10.10.10.1:50052 10.10.11.3:50052"

# worker 通道身份（2026-10-29 · O-181）：持有各 worker SSH 密钥的服务用户。
# 为什么必须写在清单里：infer-load / infer-unload 由 sudo 执行时 `id -un` = root，
# 而 root 的 ~/.ssh 无密钥、无 known_hosts ⇒ 远端一律 `Host key verification failed:`。
# 显式环境变量 RPC_USER 仍优先于本行（临时换用户时不必改文件）。
RPC_USER=scott-lau
