#!/bin/bash
# infer-unload — 停两站全部推理实例 (systemd llama + vllm + unsloth + ds4) + RPC worker, 等 GTT 释放
set -euo pipefail
log() { echo "[infer-unload] $(date '+%H:%M:%S') $*"; }

# ---- worker 通道（两种模式共用；2026-09-15 修）----------------------------
# ⚠ ssh 必须用**持有节点密钥的服务用户**: 以 root 跑本脚本时 root 无密钥 (与 infer-load 真因①同源)。
RPC_USER="${RPC_USER:-$(id -un)}"
if [ "$(id -u)" = "0" ]; then SSHX=(sudo -u "$RPC_USER" ssh -o BatchMode=yes)
else SSHX=(ssh -o BatchMode=yes); fi
NODES_ENV_F="${NODES_ENV:-/etc/llama-instances/nodes.env}"
NODES_LIST=""
if [ -f "$NODES_ENV_F" ]; then
  NODES_LIST="$("${RPC_NODES_BIN:-/usr/local/bin/rpc-nodes}" --all 2>/dev/null || true)"
fi

# ---- O-179（2026-10-28）: **alias 级卸载** --------------------------------
# 用法: `infer-unload <alias>` 只停这一个别名；无参数 = 全站清空（旧语义，逐字保留在下面）。
# 为什么必须单列一条路: 老实现只会 `systemctl stop 'llama-server@*'` —— 一个通配就把同站
# 其它模型一起杀了，"单站多模型共存"根本立不住。
# ★ 2026-10-29 二修：旧版 alias 模式**一律不 pkill**（理由"unsloth/vllm/ds4 没有 alias 归属"），
#   代价是 `unload --alias gpt-oss-20b` **什么也没停** —— studio 仍占着端口与显存，只能手工 kill。
#   现在归属判据有了：每个别名 conf 有 `MODEL_PATH`，而进程 argv 里带的正是同一个路径
#   （`unsloth studio run --model <path>` / `llama-server -m <path>`）⇒ 按"命令行是否含本模型
#   路径"认领，既不停别人、也不再漏杀。
#   ⚠ 判不出（conf 缺失 / MODEL_PATH 空）⇒ **不猜**：只停 systemd 单元 + 留 WARN，
#   绝不退回全量 pkill（那等于换个名字做全站清空）。
ALIAS="${1:-}"
if [ -n "$ALIAS" ]; then
  log "只卸别名 ${ALIAS}（同站其它模型保持不动）"
  # ① systemd 单元（llama 系；rpc-server 为 RPC worker 形态）
  sudo systemctl stop "llama-server@${ALIAS}" 2>/dev/null || true
  sudo systemctl stop "rpc-server@${ALIAS}" 2>/dev/null || true
  # ② 非 systemd 形态：按 **MODEL_PATH** 认领（unsloth studio / 手起 llama-server / ds4）
  _mp=""
  for _c in "/etc/llama-instances/${ALIAS}.env" "/etc/ds4-instances/${ALIAS}.env"; do
    if [ -f "$_c" ]; then
      _mp=$(sed -n 's/^MODEL_PATH=//p' "$_c" 2>/dev/null | tail -1 | tr -d '"' || true)
      [ -n "$_mp" ] && break
    fi
  done
  if [ -n "$_mp" ]; then
    _hits=""
    for _p in $( { pgrep -f '[u]nsloth studio run' || true; pgrep -f '[l]lama-server' || true; \
                   pgrep -f '[d]s4-server' || true; pgrep -f '[d]s4 .*--role' || true; } \
                 | sort -u || true); do
      _cmd=$(tr '\0' ' ' < "/proc/${_p}/cmdline" 2>/dev/null || true)
      case "$_cmd" in
        *"$_mp"*) _hits="$_hits $_p" ;;
      esac
    done
    if [ -n "$_hits" ]; then
      log "停本模型的非 systemd 实例 (pid=$(printf '%s' "$_hits" | tr -d '\n'))"
      for _p in $_hits; do
        pkill -9 -P "$_p" 2>/dev/null || true   # studio 派生的 llama-server 子进程
        kill -9 "$_p" 2>/dev/null || true
      done
    else
      log "未发现该模型的非 systemd 实例（unsloth / 手起 llama-server / ds4）"
    fi
  else
    log "WARN: 未取到 ${ALIAS} 的 MODEL_PATH —— 只停了 systemd 单元；非 systemd 形态未动（不猜、不越界）"
  fi
  # ③ 远端 worker
  if [ -n "$NODES_LIST" ]; then
    for node in $NODES_LIST; do
      ip="${node%%:*}"
      log "停远端 worker ${node} 的 rpc-server@${ALIAS}..."
      "${SSHX[@]}" "$ip" "sudo systemctl stop 'rpc-server@${ALIAS}' 2>/dev/null" 2>/dev/null || true
    done
  fi
  log "alias 模式: 未做 unsloth/vllm/ds4 的**全量**清扫（只按本模型路径认领）"
  exit 0
fi

# ---- 以下为**无参全停**（旧行为，逐字保留）--------------------------------
log "停 B 站 llama-server@*..."
sudo systemctl stop 'llama-server@*' 2>/dev/null || true
log "停 B 站 unsloth 实例..."
pkill -9 -f "[u]nsloth studio run" 2>/dev/null || true
pkill -9 -x llama-server 2>/dev/null || true
# 停 ds4 (DwarfStar) 实例 —— 幂等, 防护性字符类 [d] 避免 pkill 自匹配自身命令行:
#   · ds4-server: 单机 / coordinator 形态   · ds4 主程序 + --role: worker 形态
#   ★ worker 模式必须是 '[d]s4 .*--role' (非 '[d]s4 --role') —— 真实命令行 'ds4 --rocm --role worker'
#     中间夹 '--rocm', 连续子串 '[d]s4 --role' 永不命中 (2026-09-28 实测假阴性)。
log "停 ds4 (DwarfStar) 实例..."
pkill -9 -f '[d]s4-server' 2>/dev/null || true
pkill -9 -f '[d]s4 .*--role' 2>/dev/null || true
if pgrep -f 'vllm.entrypoint[s]' >/dev/null 2>&1; then
  log "停 vLLM..."
  pkill -f 'vllm.entrypoint[s]' 2>/dev/null || true
  pkill -f '^ray::' 2>/dev/null || true
  "$HOME/vllm-rocm/bin/ray" stop -f 2>/dev/null || true
fi

# ---- 停 RPC worker (两层, 都幂等; 2026-09-15 修) ----
# 原先只 ssh A 站停 rpc-server。C 站 2026-09-15 起也是 worker (nodes.env 的 RPC_NODES 声明 A+C)
# ⇒ 每轮双机加载都会在 C 留下常驻 `rpc-server@<alias>`, 让集群门禁 engine 项长期黄灯
# (实测 "C 站引擎在服务: 端口 50052 · RSS 0G / 有端口在听但 RSS 仅 121M")。
# (RPC_USER / SSHX / NODES_ENV_F / NODES_LIST 已在文件头统一解析 —— alias 模式共用)
# ① 本站就地停 —— 不经 ssh: 避开"自 ssh 到本机 USB4 IP"的 host key 坑 (实测 A/C 均 Host key verification failed),
#    也让"单独在某台 worker 上跑 infer-unload"真能停掉它自己的 rpc-server。
log "停本站 rpc-server@*..."
LOCAL_RPC_WAS=$(systemctl list-units 'rpc-server@*' --state=active --no-legend 2>/dev/null | grep -q . && echo active || echo inactive)
sudo systemctl stop 'rpc-server@*' 2>/dev/null || true

# ② master 侧停**远端** worker: 清单取自 nodes.env (rpc-nodes --all), 不在脚本里再抄一份 IP。
#    nodes.env 只在 master 存在 ⇒ 非 master 站查不到清单属正常, 静默跳过 (停 worker 由 master 负责),
#    **不能**因此报 WARN —— 那会让常规 unload 看起来像出错。
RPC_WAS_ACTIVE=""
if [ "$LOCAL_RPC_WAS" = "active" ]; then RPC_WAS_ACTIVE="本站"; fi
if [ -f "$NODES_ENV_F" ]; then
  if [ -z "$NODES_LIST" ]; then log "WARN: 有 ${NODES_ENV_F} 但取不到节点清单 (rpc-nodes --all 失败)"; fi
  for node in $NODES_LIST; do
    ip="${node%%:*}"
    log "停远端 worker ${node} 的 rpc-server@*..."
    was=$("${SSHX[@]}" "$ip" "systemctl list-units 'rpc-server@*' --state=active --no-legend 2>/dev/null | grep -q . && echo active || echo inactive; sudo systemctl stop 'rpc-server@*' 2>/dev/null" 2>/dev/null | head -1 || true)
    # 本机 IP 会自 ssh 失败 (见上 ①) —— 那不算错误, 已由本地分支处理
    if [ "$was" = "active" ]; then RPC_WAS_ACTIVE="$RPC_WAS_ACTIVE ${node}"
    elif [ -z "$was" ]; then log "WARN: ${ip} 不可达 —— 该 worker 是否仍在跑**无法确认** (不假装已停)"; fi
  done
else
  log "远端 worker: 本站无 ${NODES_ENV_F} (节点清单在 master 站), 由 master 侧的 unload 负责"
fi

wait_gtt() {  # $1=tag, $2=ip (缺省=本站)
  for i in $(seq 1 90); do
    if [ -n "$2" ]; then used=$("${SSHX[@]}" "$2" "cat /sys/class/drm/card*/device/mem_info_gtt_used 2>/dev/null | head -1" || true)
    else used=$(cat /sys/class/drm/card*/device/mem_info_gtt_used 2>/dev/null | head -1 || true); fi
    if [ -z "$used" ]; then used=0; fi
    if [ "$used" -lt 2000000000 ]; then log "$1 GTT released (${used}B)"; return 0; fi
    sleep 2
  done
  log "WARN: $1 GTT 未完全释放"
}
wait_gtt "本站" ""
for tag in $RPC_WAS_ACTIVE; do
  if [ "$tag" = "本站" ]; then continue; fi
  wait_gtt "RPC ${tag}" "${tag%%:*}"
done
log "UNLOADED ✓ (两站内存回收)"
