# qwen-flavor-nothink.env - L1 instance-layer preset for complexity route flavor "nothink"
# Maps to profile code/doc (taskType=code|doc => thinking OFF). This is the PROVEN-BEST
# default config (ctx8192 + code thinking disabled, B6 5/5) - NO jinja reasoning force.
# Source of truth: ops/station-bin/qwen-flavor-nothink.env (console/git). Deployed to B
# station /etc/llama-instances/qwen3.8-27b-mtp.env by _switch_qwen_flavor(.ps1) in a
# manual idle-window switch. NOT loaded until user triggers the switch.
MODEL_PATH=/data/models/gguf/Jackrong/Qwen3.8-27B-MTP-GGUF/Qwen3.8-27B-MTP-Q8_0.gguf
LLAMA_SERVER_BIN=/home/scott-lau/llama.cpp/build/bin/llama-server
PORT=18080
CTX=8192
THREADS=16
N_CPU_MOE=0
RPC_TARGET=
BACKEND=llama-single
EXTRA_FLAGS="--mmproj /data/models/gguf/Jackrong/Qwen3.8-27B-MTP-GGUF/mmproj-F32.gguf --flash-attn on --device Vulkan0 --spec-type draft-mtp --spec-draft-n-max 5 --parallel 1 --no-context-shift"