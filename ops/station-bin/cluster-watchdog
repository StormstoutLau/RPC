#!/bin/bash
# cluster-watchdog — 双机集群 health 看门狗 (D1.1)
# 部署: 两站 /usr/local/bin + cluster-watchdog.{service,timer} (60s oneshot)
# 模态覆盖: M2 服务冻结(本机处置) / M3+M4 主机失联(对端探测,只通知) / M5 GTT 残留(告警)
# 边界: 不自动拉起模型(零自加载); 对端故障不远程处置(M3/M4 冻结域外无处置能力)
# 维护: 先改仓库 ops/station-bin/ 再同步上站 (station-bin 约定)
# 差异: 两站仅下行 PEER 不同 — A 站=192.168.10.32, B 站=192.168.10.33 (管理 LAN)
set -euo pipefail

PEER="${PEER:-192.168.10.33}"            # 缺省 B 站(peer A)；A 站部署改 PEER=192.168.10.32
SERVICE_USER="${SERVICE_USER:-scott-lau}"
PEER_USER="$SERVICE_USER"
STATE_DIR="/var/lib/cluster-watchdog"
LOG="/var/log/cluster-watchdog.log"
GTT_WARN_BYTES=$((20*1024*1024*1024))    # 无 active 实例时 GTT 残留告警线 20G
WARN_AFTER=3                             # 连续失败 N 次 → WARN
ACT_AFTER=5                              # 连续失败 N 次 → 处置 (仅本机 M2)

if [ ! -d "$STATE_DIR" ]; then
  sudo mkdir -p "$STATE_DIR" && sudo chown "$SERVICE_USER:$SERVICE_USER" "$STATE_DIR"
fi
if [ ! -w "$LOG" ]; then
  sudo touch "$LOG" && sudo chown "$SERVICE_USER:$SERVICE_USER" "$LOG"
fi
ts() { date '+%F %T'; }
log() { echo "[watchdog] $(ts) $*" | tee -a "$LOG" >&2; }
load_ctr() { cat "$STATE_DIR/$1" 2>/dev/null || echo 0; }
save_ctr() { echo "$2" > "$STATE_DIR/$1" 2>/dev/null; }
# 读取实例健康端口: 从 /etc/llama-instances/<alias>.env 的 PORT 取, 缺省 8080 (兼容旧拓扑)
inst_port() {
  local svc="$1" alias e p
  [ -n "$svc" ] || { echo 8080; return; }
  alias="${svc#llama-server@}"
  alias="${alias%.service}"                 # systemctl 单元名带 .service, env 名裸别名
  e="/etc/llama-instances/${alias}.env"
  p=$(grep -E '^PORT=[0-9]' "$e" 2>/dev/null | head -1 | cut -d= -f2 | tr -d '"' || true)
  [ -n "$p" ] && echo "$p" || echo 8080
}

ACTIVE=$(systemctl list-units 'llama-server@*' --state=active --no-legend 2>/dev/null | awk '{print $1}' | head -1 || true)
LOADING=$(pgrep -f 'infer-load|infer-unload|load-mem-gate' >/dev/null 2>&1 && echo yes || echo no)

# ── 探测 1: 本机服务冻结 (M2, 处置) ────────────────────
if [ -z "$ACTIVE" ]; then
  save_ctr fail.local 0                  # 未加载是正常态 (零自加载原则)
elif [ "$LOADING" = "yes" ]; then
  :                                      # 加载/卸载窗口跳过 (防 Loading 期 503 误报), 计数不动
else
  HPORT=$(inst_port "$ACTIVE")
  if curl -sf -m 8 "http://127.0.0.1:${HPORT}/health" >/dev/null 2>&1; then
    save_ctr fail.local 0
  else
    n=$(($(load_ctr fail.local)+1)); save_ctr fail.local "$n"
    if [ "$n" -ge "$WARN_AFTER" ]; then log "WARN: 本机服务无响应 x${n} ($ACTIVE) [M2]"; fi
    if [ "$n" -ge "$ACT_AFTER" ]; then
      if systemctl is-active --quiet "$ACTIVE" 2>/dev/null; then
        log "ACT: restart $ACTIVE [M2 处置]"
        sudo systemctl restart "$ACTIVE" 2>/dev/null || log "ERR: restart $ACTIVE 失败"
      fi
      save_ctr fail.local 0              # 处置后清零; 若再挂重新计数
    fi
  fi
fi

# ── 探测 2: 本机 GTT 残留 (M5, 只告警) ────────────────
if [ -z "$ACTIVE" ]; then
  used=$(cat /sys/class/drm/card*/device/mem_info_gtt_used 2>/dev/null | head -1 || true)
  if [ -n "$used" ] && [ "$used" -gt "$GTT_WARN_BYTES" ]; then
    log "WARN: GTT 残留 $((used/1024/1024/1024))G (无 active 实例) [M5: LM Studio GUI 或孤儿进程?]"
  fi
fi

# ── 探测 3: 对端三态 (M3/M4 通知, 不处置) ──────────────
# ⚠ 远端脚本用**引用型 heredoc**（`<<'PEER_EOF'`）：此前是单引号串里又写 `awk '{print $1}'`，
#   外层引号被内层 `'` 提前闭合 ⇒ `$1` 在**本地**展开（2026-10-28 开 `-u` 后当场暴露
#   `行 84: $1: 未绑定的变量`；此前只是静默把它展成空串、远端 awk 少一个字段）。
PEER_STATE=$(ssh -o BatchMode=yes -o ConnectTimeout=10 "$PEER_USER@$PEER" bash -s <<'PEER_EOF'
  A=$(systemctl list-units "llama-server@*" --state=active --no-legend 2>/dev/null | awk '{print $1}' | head -1)
  if [ -z "$A" ]; then
    echo IDLE
  else
    AP="${A#llama-server@}"; AP="${AP%.service}"
    E="/etc/llama-instances/${AP}.env"
    HP=$(grep -aE "^PORT=[0-9]" "$E" 2>/dev/null | head -1 | cut -d= -f2 | tr -d "\"")
    HP=${HP:-8080}
    if curl -sf -m 8 "http://127.0.0.1:${HP}/health" >/dev/null 2>&1; then echo OK; else echo FROZEN; fi
  fi
PEER_EOF
) || true

case "$PEER_STATE" in
  OK|IDLE)
    save_ctr fail.peer 0 ;;
  FROZEN)
    log "WARN: 对端 $PEER 服务冻结 (SSH OK + health 挂) — 对端本机看门狗自治 [对端 M2]" ;;
  *)
    n=$(($(load_ctr fail.peer)+1)); save_ctr fail.peer "$n"
    if [ "$n" -ge "$WARN_AFTER" ]; then log "WARN: 对端 $PEER 主机失联 x${n} [M3/M4] — 若 A 站: 遗言见 B:/var/log/netconsole-a.log"; fi ;;
esac
