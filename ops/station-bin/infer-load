#!/bin/bash
# infer-load <alias前缀> [--backend unsloth|llama-rpc|llama-single|vllm|ds4] [--engine <变体名|绝对路径>] [--rpc-target <ip:port>] [--port N] [--ctx N] [--threads N]
#   --engine: 引擎**变体**(与 backend 正交), 落实例 conf 的 LLAMA_SERVER_BIN, 由 llama-serve-instance 既有钩子消费。
#             名 -> /opt/llama.cpp-<名>/llama-server (例: --engine glm5next-20260928); 也接受绝对路径。
#   --rpc-target (2026-10-22): 仅 llama-rpc; **仅本次加载**覆盖 conf 的 RPC_TARGET (worker 指派),
#             不落 conf —— head 固定权重站 B, worker A|C 由调用方 (cluster.py --worker) 决定。
# 默认后端 = unsloth (unsloth studio run 加载)
#   引擎真身 (2026-09-17 实测订正): studio 自带 ~/.unsloth/llama.cpp/llama-server
#     -> ~/.unsloth/llama.cpp/build/bin/llama-server (HIP/ROCm, 0.3.0-dev b10715 / commit 92cedc867)
#   ⚠ 原文写"引擎 = LLAMA_SERVER_PATH 指向的 llama-server" —— 与实测不符: 该变量的缺省值曾指向
#     ~/llama.cpp-vulkan-b10715/llama-server (该目录已于 2026-09-08 清除), 属悬空配置。
#     studio 的解析顺序 (studio/backend/core/inference/llama_cpp.py:7558) 为:
#       LLAMA_SERVER_PATH -> UNSLOTH_LLAMA_CPP_PATH -> studio 自定义路径设置 -> ~/.unsloth/llama.cpp/...
#     故本脚本**不再注入**该变量, 让 studio 用自带引擎; 需要自定义引擎时由调用方显式 export。
# 旧后端 llama-rpc/llama-single/vllm 保留 (systemd llama-server 路径), 可用 --backend 显式回退
# 首次加载自动生成默认 conf (打印路径)
set -euo pipefail
AWORK="$(id -un)@10.10.10.1"

PREFIX=""; BACKEND=""; PORT=""; CTX=""; THREADS=""; CLI_ENGINE=""; CLI_RPC_TARGET=""; CLI_PP_LISTEN=""; KEEP=""
while [ $# -gt 0 ]; do
  case "$1" in
    --backend) BACKEND="$2"; shift 2 ;;
    --engine|-e) CLI_ENGINE="$2"; shift 2 ;;
    --rpc-target) CLI_RPC_TARGET="$2"; shift 2 ;;
    --pp-listen) CLI_PP_LISTEN="$2"; shift 2 ;;
    --port) PORT="$2"; shift 2 ;;
    --ctx) CTX="$2"; shift 2 ;;
    --threads) THREADS="$2"; shift 2 ;;
    --keep) KEEP=1; shift ;;         # O-179: 只停本别名, 保留同站其它模型
    *) PREFIX="$1"; shift ;;
  esac
done
[ -n "$PREFIX" ] || { echo "用法: infer-load <alias前缀> [--backend unsloth|llama-rpc|llama-single|vllm|ds4] [--engine <变体名|绝对路径>] [--rpc-target <ip:port>] [--pp-listen <ip>] [--port N] [--keep]"; exit 1; }

log() { echo "[infer-load] $(date '+%H:%M:%S') $*"; }

# ---- 共享库 (P1 #3/#4, 2026-10-27) ----
# model-locate.sh: 模型定位唯一实现（#3）；conf-lib.sh: conf 读写唯一实现（#4）。
# source 后必须断言函数存在 —— 非交互 bash 下 `. 缺失文件` 只返回非零**不退出**，
# 若无断言会退化成 "model_file_for_alias: command not found" 式误导诊断。
_self=${BASH_SOURCE[0]}
case "$_self" in */*) ;; *) _self=$(command -v -- "$_self" || true) ;; esac
HERE=$(cd "$(dirname "$(readlink -f "$_self")")" && pwd)
. "$HERE/model-locate.sh"
. "$HERE/conf-lib.sh"
for _fn in model_scan model_aliases model_file_for_alias conf_escape conf_set_kv conf_get_kv; do
  command -v "$_fn" >/dev/null 2>&1 || {
    echo "ERROR: 共享库加载失败 ($_fn 缺失, HERE=$HERE)"; exit 1
  }
done
unset _self _fn

# P1 #7: --pp-listen 只接受 IP 字符（防止把任意串拼进远端/conf）。
if [ -n "${CLI_PP_LISTEN:-}" ]; then
  case "$CLI_PP_LISTEN" in
    *[!0-9A-Fa-f:.]*) log "ERROR: --pp-listen 非法 IP: '${CLI_PP_LISTEN}'"; exit 1 ;;
  esac
fi

# ---- 引擎变体解析 (2026-09-28, GLM-5.3-Flash / glm5next 分支) ----
# 为什么**不做成新 backend**: "引擎变体"与现有 backend 枚举的轴**不正交** ——
#   现有 backend 混了"引擎+拓扑"(unsloth=studio单机, llama-rpc=双机, llama-single=单机),
#   而 glm5next 变体**既能单机也能走 RPC** ⇒ 若加成 backend 会产生组合爆炸。
# 故表达为实例 conf 的一个值 LLAMA_SERVER_BIN, 由 llama-serve-instance 的**既有钩子**消费
#   (该文件 L31 已写 `exec "${LLAMA_SERVER_BIN:-/opt/llama.cpp/llama-server}" …`, 注释里本就列为测试缝隙)。
# 语义: --engine <名> -> /opt/llama.cpp-<名>/llama-server; --engine /abs/path 原样使用。
ENGINE_BIN=""
if [ -n "$CLI_ENGINE" ]; then
  case "$CLI_ENGINE" in
    /*) ENGINE_BIN="$CLI_ENGINE" ;;
    *)  ENGINE_BIN="/opt/llama.cpp-${CLI_ENGINE}/llama-server" ;;
  esac
  if [ ! -x "$ENGINE_BIN" ]; then
    echo "ERROR: 引擎变体不存在或不可执行: $ENGINE_BIN"
    echo "       站上现有变体: $(ls -d /opt/llama.cpp* 2>/dev/null | tr '\n' ' ')"
    exit 1
  fi
fi

# ---- [1] 解析 alias (前缀匹配, **精确匹配优先**) ----
# 2026-09-16 修 (两个缺陷):
#   ① 原实现只有前缀匹配 => 传**精确别名**也被判歧义。实测 `grep "^gpt-oss-120b"` 同时命中
#      gpt-oss-120b 与 gpt-oss-120b-fable-5-distilled => `load gpt-oss-120b-b` 直接 exit 1。
#   ② PREFIX 未转义 => `.` 是正则通配, `qwen3.8` 会命中 `qwen3x8` (误配)。
#   修法: 候选集全列出 -> 精确相等者直接胜出 -> 否则才走唯一前缀; 前缀比较用 shell `case` 按**字面**串。
# ★ 2026-10-12 修 Bug B: 原实现按 depth-2 的**目录级** find 找模型目录
#   ⇒ `gguf/<repo>/<file>.gguf` 这种"仓库级直放"(depth-1) **完全看不到** —— 实测 B 站
#   `davidau-q38-27b-q4k` 有 conf(:18081)、能加载, 却在这里被判"无匹配 '$PREFIX'"。
#   ⚠ 同一缺陷 **infer-list 已于 2026-09-15 修掉**(其头部注释①逐字记的就是本例), 改按
#   gguf **文件**分组; 但**本文件未同步** ⇒ 两个同源脚本的别名规则脱钩 (infer-list 头部
#   本就要求"别名规则须与 ... 站上 infer-load 一致")。现改为**与 infer-list scan() 同规则**:
#     gguf/<repo>/<file>.gguf            → 模型 = <repo>                    (NF == 2)
#     gguf/<repo>/<Model>-GGUF/…/<file>  → 模型 = <Model>                  (NF >= 3)
ALL_ALIASES=$(model_aliases)
# ★ ds4 后端: 别名来自另一个命名空间 (2026-09-28, ADR-0010 / spec/ds4-backend/DESIGN.md §2/§4.2)。
#   为什么必须分家: ds4 是**项目专属 GGUF、非通用加载器**, 其模型刻意**不并入** /data/models/gguf ——
#   否则 infer-list/models 会扫出一个 llama.cpp 根本加载不了的模型 (DESIGN §2 三条隔离原则之②)。
#   ds4 的单一命名真值 = conf 文件名 /etc/ds4-instances/<alias>.env ⇒ 别名由文件名派生。
if [ "$BACKEND" = "ds4" ]; then
  ALL_ALIASES=$(find /etc/ds4-instances -maxdepth 1 -name '*.env' 2>/dev/null | \
    sed 's|.*/||; s|\.env$||' | tr 'A-Z' 'a-z' | sort -u || true)
fi
LOWER=$(printf '%s' "$PREFIX" | tr 'A-Z' 'a-z')
EXACT=""; PFX=""
while IFS= read -r _a; do
  if [ -z "$_a" ]; then continue; fi
  if [ "$_a" = "$LOWER" ]; then EXACT="$_a"; break; fi
  case "$_a" in "$LOWER"*) PFX="${PFX}${_a}
";; esac
done <<ALIAS_EOF
$ALL_ALIASES
ALIAS_EOF
if [ -n "$EXACT" ]; then
  ALIAS="$EXACT"
else
  N=$(printf '%s' "$PFX" | grep -c . || true)
  if [ "$N" -eq 0 ]; then
    echo "ERROR: 无匹配 '$PREFIX' (infer-list 查看)"
    echo "候选 alias: $(printf '%s' "$ALL_ALIASES" | tr '\n' ' ')"
    exit 1
  fi
  if [ "$N" -gt 1 ]; then echo "ERROR: 前缀歧义 ($N 匹配):"; printf '%s\n' "$PFX"; exit 1; fi
  ALIAS=$(printf '%s' "$PFX" | head -1)
fi

# ---- [2] 定位模型文件 + 生成 conf (若缺) ----
# ★ ds4 走独立命名空间 (2026-09-28, ADR-0010 / DESIGN §2/§4.2): 模型在 ~/ds4/gguf,
#   conf 在 /etc/ds4-instances/<alias>.env。故本段对 ds4 **不生成** llama 系 conf、
#   **不 source** 它 (两套命名空间刻意隔离), 只做存在性校验; 真正读取在 [4b]。
if [ "$BACKEND" = "ds4" ]; then
  CONF="/etc/ds4-instances/${ALIAS}.env"
  if [ ! -f "$CONF" ]; then
    echo "ERROR: ds4 conf 不存在: $CONF (见 spec/ds4-backend/DESIGN.md §4.2)"; exit 1
  fi
  log "ds4 后端: 跳过 llama 模型库定位/conf 生成 (conf=$CONF)"
  CLI_BACKEND="${BACKEND}"
  CLI_PORT="${PORT:-}"; CLI_CTX="${CTX:-}"; CLI_THREADS="${THREADS:-}"
else
CONF="/etc/llama-instances/${ALIAS}.env"
if [ ! -f "$CONF" ]; then
  # P1 #3: 模型文件由共享库定位（文件级枚举，覆盖三种落点；旧实现 depth-2 目录会漏仓库级直放）。
  F=$(model_file_for_alias "$ALIAS") || {
    echo "ERROR: 模型文件未找到 (alias=$ALIAS)"
    echo "候选 alias: $(model_aliases | tr '\n' ' ')"
    exit 1
  }
  REPO=$(dirname "$F")
  if echo "$F" | grep -q -- '-of-0000'; then SZ=$(du -smL "$REPO" | cut -f1); else SZ=$(( $(stat -c%s "$F") / 1048576 )); fi
  # 后端默认判定: 默认 unsloth (除 embedding 小模型用 llama-single)
  if [ -z "$BACKEND" ]; then
    case "$ALIAS" in all-minilm*) BACKEND="llama-single";; *) BACKEND="unsloth";; esac
  fi
  RPCV=""
  if [ "$BACKEND" = "llama-rpc" ]; then RPCV="auto"; fi
  # N_CPU_MOE 缺省 (2026-09-29 改): 原为 `llama-rpc ⇒ 8` —— 那是**单机**省 VRAM 的腾挪手段
  #   (把前 8 层 MoE 专家压到 CPU); 在**双机 RPC** 形态下它把前 8 层专家压到 head 的 CPU 上算
  #   ⇒ 实测 decode 掉约 22%(V4-Flash 双机 10.90 vs 手工形态 14.06 t/s)。
  #   对齐目标是**手工成功形态**(完全不给 `--n-cpu-moe`, 等价于 0) ⇒ 缺省改 0。
  #   ⚠ 本行只在**首次生成 conf** 时生效; 已存在的 conf 不会被改写(要改请直接编辑 conf)。
  NCM=0
  EMB=""; case "$ALIAS" in all-minilm*) EMB="--embedding";; esac
  # P1 #4: MODEL_PATH 走 conf_escape（双引号 + 固定转义集），与 conf_get_kv/conf_parse 互逆。
  MP_ESC=$(conf_escape "$F") || { echo "ERROR: MODEL_PATH 含非法字符 (换行)"; exit 1; }
  sudo tee "$CONF" >/dev/null <<CEOF
# B5i 自动生成 ($(date '+%F %T')) [默认后端 unsloth] — 可编辑后 infer-load(重载) 或 systemctl 回退
MODEL_PATH="${MP_ESC}"
PORT=${PORT:-8080}
CTX=${CTX:-32768}
THREADS=${THREADS:-16}
N_CPU_MOE=${NCM}
RPC_TARGET=${RPCV}
EXTRA_FLAGS="-fa on ${EMB}"
# STUDIO_FLAGS: **仅 unsloth 路径**追加的调优旗标 (2026-10-21, ADR-0014 D7 后续)。
#   禁含 -c/--ctx-size/-fa/--flash-attn —— CTX 与 flash-attn 由本 wrapper 拥有, 重复 -c 是
#   llama.cpp 硬失败面, 且会造成"两处真值"。例:
#   STUDIO_FLAGS="--parallel 1 -b 4096 -ub 1024 --cache-reuse 256"
STUDIO_FLAGS=""
BACKEND=${BACKEND}
CEOF
  log "conf 生成: $CONF (backend=$BACKEND)"
fi
# 显式 --backend 必须**先存下来**: conf 里的 BACKEND= 会覆盖同名 shell 变量
CLI_BACKEND="${BACKEND:-}"
# 同理: --port / --ctx / --threads 也会被 `source "$CONF"` 静默覆盖 ——
# 2026-09-15 实测: `infer-load <alias> --ctx 4096` 后日志仍打印 `ctx 262144` (conf 值),
# 即 CLI 参数**完全没生效**。与 --backend 同一类 bug (source 覆盖同名变量)。
CLI_PORT="${PORT:-}"; CLI_CTX="${CTX:-}"; CLI_THREADS="${THREADS:-}"
source "$CONF"

# ---- 引擎变体落 conf (CLI 优先; 2026-09-28) ----
# 为什么必须**落 conf** 而不能只 export: llama-rpc/llama-single 实际由 systemd 单元
#   llama-server@<alias> 驱动, 单元经 llama-serve-instance **重新 source 同一 conf** ——
#   只改本进程环境对单元无效 (与 [2c] 的 RPC_TARGET `/run` 覆盖是同一类教训)。
# ds4 另立命名空间 (/etc/ds4-instances), 不写 llama 系键。
#
# 2026-09-29 扩到**两个键**(GLM-5.3-Flash 分布式) —— 一个实例的"引擎变体"其实有**两个**消费者:
#   · head   → `<dir>/llama-server`      (键 LLAMA_SERVER_BIN, llama-serve-instance 消费)
#   · worker → `<dir>/ggml-rpc-server`   (键 LLAMA_RPC_SERVER_BIN, 由 rpc-nodes --start 透传给
#     各节点的 rpc-server@<alias> 单元)。★ 必须落 conf: RPC **两端版本必须一致**, 而 worker
#     站在别的机器上, 只有 conf 是全流程(read→透传)唯一的真值点。
# 注意**不做反向清理**: 未给 --engine 时不动已存在的键 —— 引擎变体是**实例属性**(可由人手工
#   编辑 conf 钉死), `--engine` 只是"顺手设置它"的入口(与 conf 头注释"可编辑后重载"一致)。
_set_conf_key() {  # _set_conf_key <KEY> <VALUE> — 幂等写/改实例 conf 的一行
  # P1 #4: 收敛到 conf_set_kv（双引号 + 转义 + mktemp/mv 原子替换）。
  # 旧实现的 sed -i 非原子、$2 未转义；"末行无换行导致追加粘连"(Bug C) 也由整文件重写结构性消除。
  conf_set_kv "$CONF" "$1" "$2" || { log "ERROR: conf 写入失败 ($1, rc=$?)"; exit 1; }
}
# ★ 2026-10-29（O-179 P2-余）：`--port` **必须落 conf** —— 与 `--engine` 同因：
#   llama-rpc / llama-single 走 systemd 单元 `llama-server@<alias>`，单元经
#   `llama-serve-instance` **重新 source 同一 conf** ⇒ 只改本进程的 PORT 变量对单元**无效**
#   （同族实测：`--ctx` 曾因 source 覆盖而完全不生效）。落 conf 后 PORT 仍是唯一真值，
#   `cluster.py` 的端口门与健康探测都从 conf 读，不复算。
# ⚠ **二修（2026-10-29 实测）**：写 conf 必须**推迟到 [3] 的端口门之后** ——
#   原先在这里就写，导致 `infer-load X --keep --port <别人占着的口>` **被拒绝也改了 conf**
#   （实测：qwen 的 conf 被写成 18081）。现在只在内存里替换，通过后再落盘。
if [ -n "$CLI_PORT" ] && [ "$CLI_PORT" != "${PORT:-}" ] && [ "${CLI_BACKEND:-}" != "ds4" ]; then
  PORT="$CLI_PORT"
  _PORT_PENDING=1
fi
if [ -n "$ENGINE_BIN" ] && [ "${CLI_BACKEND:-}" != "ds4" ]; then
  _set_conf_key LLAMA_SERVER_BIN "$ENGINE_BIN"
  LLAMA_SERVER_BIN="$ENGINE_BIN"
  log "引擎变体已落 conf: LLAMA_SERVER_BIN=${ENGINE_BIN}"
  # worker 侧引擎 = 同目录成对的 ggml-rpc-server (变体目录是一个整体)
  RPC_ENGINE_BIN="${ENGINE_BIN%/*}/ggml-rpc-server"
  if [ -x "$RPC_ENGINE_BIN" ]; then
    _set_conf_key LLAMA_RPC_SERVER_BIN "$RPC_ENGINE_BIN"
    log "worker 引擎已落 conf: LLAMA_RPC_SERVER_BIN=${RPC_ENGINE_BIN}"
  else
    log "WARN: 引擎目录内无 ggml-rpc-server (${RPC_ENGINE_BIN}) —— 该变体只能单机, RPC 双机会在 worker 侧失败"
  fi
fi
export LLAMA_SERVER_BIN="${LLAMA_SERVER_BIN:-}"
if [ -n "$LLAMA_SERVER_BIN" ]; then log "使用引擎: ${LLAMA_SERVER_BIN}"; fi
# conf 优先级: 显式 CLI > conf > 默认
BACKEND="${CLI_BACKEND:-${BACKEND:-${CONF_BACKEND:-unsloth}}}"
if [ -n "$CLI_PORT" ]; then PORT="$CLI_PORT"; fi
if [ -n "$CLI_CTX" ]; then CTX="$CLI_CTX"; fi
if [ -n "$CLI_THREADS" ]; then THREADS="$CLI_THREADS"; fi
fi   # ← 结束 [2] 的 ds4 / llama 两分支

# ---- [2b] 显式 --backend 同时决定 RPC 与否 (2026-09-15 修) ----
# 早版只切 BACKEND, 却把 conf 里的 RPC_TARGET 留着 → `--backend llama-single` 仍会
# 起 A 站 rpc-server, 且 systemd 单元按 conf 的 RPC_TARGET 带上 --rpc ——
# **名义"单机"实际"双机"**。
# 这是被 P2-4 路径对比**实测抓到**的: 单机路径的加载日志里出现了 "A 站起 rpc-server@..."。
# 判据不该只看"以为选了什么", 而要看"进程命令行里到底有没有 --rpc"。
if [ -n "$CLI_BACKEND" ]; then
  case "$CLI_BACKEND" in
    llama-rpc)
      if [ -z "${RPC_TARGET:-}" ]; then RPC_TARGET="auto"; log "显式 llama-rpc: RPC_TARGET 置 auto"; fi
      ;;
    *)
      if [ -n "${RPC_TARGET:-}" ]; then
        log "显式 ${CLI_BACKEND}: 清空 conf 的 RPC_TARGET='${RPC_TARGET}' —— 真正走单机"
        RPC_TARGET=""
      fi
      ;;
  esac
fi

# ---- [2b-2] 显式 --rpc-target: 单 worker 指派 (2026-10-22) ----
# 语义: **仅本次加载**把 conf 的 RPC_TARGET（可能是 auto / 旧 worker）替换为用户指定的
#   <ip:port>。不落 conf —— 节点指派是"每次加载的决定", conf 只承载默认值。
# 为什么必须写 /run 覆盖层: 真正执行的是 systemd 单元 llama-server@<alias>，单元会重新
#   source conf（见 [2c] 同一教训）；只改本进程 shell 变量对单元无效。
if [ -n "${CLI_RPC_TARGET:-}" ]; then
  # 字符白名单: 该值会写进 /run 覆盖层并被 systemd 单元 source ⇒ 换行/引号/空格都会破坏它。
  case "${CLI_RPC_TARGET}" in
    *[!0-9A-Za-z.:,_-]*)
      log "ERROR: --rpc-target 含非法字符: '${CLI_RPC_TARGET}' (允许 字母/数字/.:,_-) —— 拒绝加载。"
      exit 1
      ;;
  esac
  case "${BACKEND:-}" in
    llama-rpc)
      RPC_TARGET="${CLI_RPC_TARGET}"
      log "显式 --rpc-target: RPC_TARGET=${RPC_TARGET} (仅本次加载)"
      ;;
    *)
      log "ERROR: --rpc-target 仅适用于 llama-rpc 后端 (当前 BACKEND=${BACKEND:-未设定}) —— 拒绝加载。"
      exit 1
      ;;
  esac
fi
[ -n "$PORT" ] && PORT_NUM="$PORT" || PORT_NUM="${PORT:-8080}"

# ---- [2c] 运行时覆盖层: 让"显式后端"对 systemd 单元路径也生效 (2026-09-15 修) ----
# 单机/双机路径真正执行的是 **systemd 单元 llama-server@<alias>**, 单元里的
# llama-serve-instance 会**重新 source /etc/llama-instances/<alias>.env** ——
# 于是上面 [2b] 清掉本脚本 shell 里的 RPC_TARGET **对单元无效**, 单元照样按 conf 的
# `RPC_TARGET=auto` 带上 --rpc —— 即"名义单机、实际双机"。
# (被 code 的后端生效性判据实测抓到: 请求 llama-single, 进程命令行却含 --rpc。
#  我上一版"单机无 --rpc"的验证是**假通过** —— 当时 RPC 节点恰好没起, 单元静默回退了。)
# 办法: 把最终决定写进 /run 下的覆盖文件, 由 wrapper 在 source conf **之后**再 source 一遍。
# 放 /run (tmpfs): 重启自清, 不动 /etc 下的配置。
# 未显式指定后端/目标 ⇒ 删除该文件, 回归 conf 语义 (避免上一次的覆盖变成陈旧状态)。
RUN_OVERRIDE="/run/llama-instances/${ALIAS}.env"
if [ "$BACKEND" = "ds4" ]; then
  :   # ds4 无 systemd 单元 llama-server@<alias>, 该 /run 覆盖对它无意义 ⇒ 不写 (见 [2] 的同名分家)
elif [ -n "$CLI_BACKEND$CLI_RPC_TARGET" ]; then
  # ★ 2026-10-22: --rpc-target 单独给出也必须写覆盖 —— 否则本进程 [5] 起了指定 worker,
  #   单元却仍按 conf 的 RPC_TARGET 起另一个 worker（"名义 A、实际 C"）。
  sudo install -d -m 0755 /run/llama-instances
  printf 'RPC_TARGET=%s\n' "${RPC_TARGET:-}" | sudo tee "$RUN_OVERRIDE" >/dev/null
  sudo chmod 644 "$RUN_OVERRIDE"
  log "运行时覆盖: ${RUN_OVERRIDE} (RPC_TARGET='${RPC_TARGET:-}')"
else
  sudo rm -f "$RUN_OVERRIDE" 2>/dev/null || true
fi

# ---- [3] 互斥: 停另一后端 (systemd llama + vllm + unsloth + ds4) ----
# ★ 2026-10-29（O-179）：`--keep` ⇒ **只停本别名**，同站其它模型保持不动。
#   为什么必须在**这里**也做：`cluster.py load --keep` 只把回收收窄到同名别名，
#   但本条一旦无条件执行，仍会把同站的 unsloth/llama 全杀 —— 实测（G1 首跑）：
#   B 站的 gpt-oss-20b(unsloth) 就是被这一条干掉的，`--keep` 在站内被打回原形。
#   unsloth / vllm / ds4 **没有 alias 归属** ⇒ keep 模式下不碰（与 infer-unload 同一纪律）。
if [ -n "$KEEP" ]; then
  # ★ 目标不是"单元停了"，而是"**本别名的端口能再次绑定**" —— 一律以端口为准。
  #   2026-10-29 二修（G1 之后实测）：旧实现只 `systemctl stop llama-server@<alias>` 再等
  #   `is-active` 落下，漏了**同别名的 unsloth 实例**（studio 名 = `<后端>(<alias>)`）⇒
  #   `load <同一 alias> --keep` 会与上一次的 studio 抢同一端口，然后白等满健康超时（15min）。
  log "停旧实例: --keep ⇒ 只停本别名 ${ALIAS}（同站其它模型保持不动）"
  sudo systemctl stop "llama-server@${ALIAS}" 2>/dev/null || true
  # ★ 归属判据 = **模型文件路径**（conf 的 MODEL_PATH），不是 pid 名、也不是日志里的
  #   `gpt-oss(<alias>)` —— 实测（2026-10-29）studio 的真实 argv 是
  #   `unsloth studio run --model <...gguf> --port 18081 ...`，**不含** `(<alias>)`；
  #   而 `ss` 显示进程名只是 `unsloth`。按"谁占着本端口 + 它的命令行是否在跑本模型"判，
  #   同一个 alias 换端口/换后端都成立。
  _pids=$(ss -ltnp 2>/dev/null | grep -E "[:.]${PORT_NUM}\b" \
            | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u || true)
  _ours=""; _foreign=""
  for _p in $_pids; do
    _cmd=$(tr '\0' ' ' < "/proc/${_p}/cmdline" 2>/dev/null || true)
    if [ -n "${MODEL_PATH:-}" ] && printf '%s' "$_cmd" | grep -qF -- "$MODEL_PATH"; then
      _ours="$_ours $_p"
    else
      _foreign="$_foreign $_p"
    fi
  done
  if [ -n "$_ours" ]; then
    log "停本别名的旧实例 (pid=$(printf '%s' "$_ours" | tr -d '\n')；判据=命令行含本模型 MODEL_PATH)"
    for _p in $_ours; do
      pkill -9 -P "$_p" 2>/dev/null || true   # studio 派生的 llama-server 子进程
      kill -9 "$_p" 2>/dev/null || true
    done
  fi
  for _i in $(seq 1 30); do
    ss -ltn 2>/dev/null | grep -qE "[:.]${PORT_NUM}\b" || break
    sleep 1
  done
  if ss -ltn 2>/dev/null | grep -qE "[:.]${PORT_NUM}\b"; then
    echo "[infer-load] ERROR: --keep 下端口 ${PORT_NUM} 仍被**别人**占用（命令行不含本模型）:"
    ss -ltnp 2>/dev/null | grep -E "[:.]${PORT_NUM}\b" || true
    for _p in $_foreign; do
      echo "[infer-load]   pid=$_p $(tr '\0' ' ' < "/proc/${_p}/cmdline" 2>/dev/null | cut -c1-120)"
    done
    echo "[infer-load]        处置: 先 unload 占用它的模型, 或换 --port —— 这里**不进入**健康等待（否则空等 15min）"
    exit 1
  fi
  log "本别名已停、端口 ${PORT_NUM} 已空（keep 模式跳过全站 GTT 等待：同站其它模型仍持显存）"
else
log "停旧实例 (llama/vllm/unsloth/ds4)..."
sudo systemctl stop 'llama-server@*' 2>/dev/null || true
# 清理 unsloth studio 进程 (命令行含 'unsloth studio run') 与底层 llama-server (防自匹配)
pkill -9 -f "[u]nsloth studio run" 2>/dev/null || true
pkill -9 -x llama-server 2>/dev/null || true
if pgrep -f 'vllm.entrypoint[s]' >/dev/null 2>&1; then
  log "停 vLLM (Ray 双机)..."
  pkill -f 'vllm.entrypoint[s]' 2>/dev/null || true
  pkill -f '^ray::' 2>/dev/null || true
  "$HOME/vllm-rocm/bin/ray" stop -f 2>/dev/null || true
  ssh -o BatchMode=yes "$AWORK" "pkill -f '^ray::' 2>/dev/null; \$HOME/vllm-rocm/bin/ray stop -f 2>/dev/null" 2>/dev/null || true
fi
# 清理 ds4 (DwarfStar) 进程 —— 幂等, 防护性字符类 [d] 避免 pkill 自匹配自身命令行:
#   · ds4-server: 单机 / coordinator 形态 (命令行含 'ds4-server')
#   · ds4(主程序) + --role: worker 形态。★ 模式必须是 '[d]s4 .*--role' 而非 '[d]s4 --role':
#     真实命令行是 `ds4 --rocm --role worker`, 'ds4' 与 '--role' 之间夹着 '--rocm'
#     ⇒ '[d]s4 --role' 这个**连续子串**永不命中 (2026-09-28 首跑实测: 假阴性, 清理失效)。
pkill -9 -f '[d]s4-server' 2>/dev/null || true
pkill -9 -f '[d]s4 .*--role' 2>/dev/null || true
fi   # ← --keep 分支到此结束（非 keep 才会走到上面的全量清扫）

# ★ 端口覆盖**通过 [3] 的端口门之后**才落 conf（见 [2b] 的二修注释）：
#   被拒绝的加载不得改任何持久状态 —— 「先验后毁」的反面同样成立。
if [ -n "${_PORT_PENDING:-}" ]; then
  _set_conf_key PORT "$PORT"
  log "PORT 落 conf: ${PORT}（覆盖会持久化，conf 仍是唯一真值）"
fi

wait_gtt() {
  for i in $(seq 1 90); do
    if [ -n "$2" ]; then
      used=$(ssh -o BatchMode=yes "$2" "cat /sys/class/drm/card*/device/mem_info_gtt_used 2>/dev/null | head -1" || true)
    else
      used=$(cat /sys/class/drm/card*/device/mem_info_gtt_used 2>/dev/null | head -1 || true)
    fi
    if [ -z "$used" ]; then used=0; fi
    if [ "$used" -lt 2000000000 ]; then log "$1 GTT released"; return 0; fi
    sleep 2
  done
  log "WARN: $1 GTT 180s 未释放"
}
if [ -n "$KEEP" ]; then
  log "站点/worker GTT 等待跳过（keep: 别的模型本就占着显存, 等<2G 是必假阴性）"
else
  wait_gtt "B" ""
  if [ -n "${RPC_TARGET:-}" ]; then
    # ★ 2026-10-22: 等**本次实际 worker** 的 GTT，而非恒等 A —— 单 worker 指派到 C 时，
    #   等 A 是错的（C 上的旧引擎仍占着显存，rpc-server 会在加载中途 OOM）。
    #   auto 保留旧语义（多 worker 形态，A 是既有代表）；显式值取 <ip>:<port> 的 ip，
    #   与 cluster.py 的 LAN IPv4 同一地址真值（ADR-0006）。
    if [ "$RPC_TARGET" = "auto" ]; then
      wait_gtt "A" "$AWORK"
    else
      W_IP="${RPC_TARGET%%:*}"
      wait_gtt "worker(${W_IP})" "$(id -un)@${W_IP}"
    fi
  else
    log "worker GTT 跳过 (单机模式: RPC_TARGET 空, worker 站资源与本加载无关)"
  fi
fi

# ---- [4] vLLM 路径 (回退) ----
if [ "$BACKEND" = "vllm" ]; then
  log "vLLM 路径: 调 a4_vllm_launch.sh (仅 m27-awq 验证)..."
  exec bash "$HOME/scripts/a4_vllm_launch.sh"
fi

# ---- [4b] ds4 (DwarfStar) 路径 (2026-09-28, 见 spec/ds4-backend/DESIGN.md) ----
# 三种形态 (由 conf 的 PP_ROLE 决定):
#   空          = 单机 ds4-server (带 HTTP 面)
#   worker      = ds4 --role worker (只持层片 + KV 分片, **无 HTTP 面**)
#   coordinator = ds4-server --role coordinator (持 prompt/采样 + HTTP 面)
# ★ ds4 在 ROCm 不支持 TP (源码门禁 "tensor parallelism requires the Metal backend"),
#   ⇒ 双机**只有 PP** (层切片 --layers, 闭区间, 末段写 :output)。
# ★ ds4 运行必须注入**进程级** LD_LIBRARY_PATH (core-10.0 的 sysdeps + 本体 so) ——
#   严禁写 /etc/ld.so.conf.d/ 或系统 profile (见 DESIGN §2.1)。
# conf 缺省路径 /etc/ds4-instances/${ALIAS}.env; 可用环境变量 DS4_CONF 覆盖 (便于测试)。
if [ "$BACKEND" = "ds4" ]; then
  DS4_HOME="${DS4_HOME:-$HOME/ds4}"
  DS4_CONF="${DS4_CONF:-/etc/ds4-instances/${ALIAS}.env}"
  if [ ! -f "$DS4_CONF" ]; then
    log "ERROR: ds4 conf 不存在: $DS4_CONF (见 spec/ds4-backend/DESIGN.md §4.2) —— 拒绝加载, 不静默回退。"
    exit 1
  fi
  # shellcheck disable=SC1090
  source "$DS4_CONF"
  ROCM_PATH="${ROCM_PATH:-/opt/rocm/core-10.0}"
  CTX="${CTX:-32768}"
  PP_ROLE="${PP_ROLE:-}"
  PP_PORT="${PP_PORT:-9911}"
  HTTP_PORT="${HTTP_PORT:-${PORT_NUM:-8080}}"
  DS4_LOG_DIR="${DS4_LOG_DIR:-/var/log/ds4}"

  # P1 #7: PP 绑定地址。优先级 CLI > conf/env；未显式给值时：
  #   coordinator ⇒ **中止**（它必须绑定一个 worker 可达的直连段 IP，不能默认 0.0.0.0）；
  #   worker      ⇒ 不使用该值；
  #   单机        ⇒ 变量默认 127.0.0.1，但不向引擎传 --listen（HTTP 面仍 --host 127.0.0.1）。
  _PP_EXPLICIT="${CLI_PP_LISTEN:-${PP_LISTEN:-}}"
  PP_LISTEN="${_PP_EXPLICIT:-127.0.0.1}"
  if [ "$PP_ROLE" = "coordinator" ] && [ -z "$_PP_EXPLICIT" ]; then
    log "ERROR: PP coordinator 需要一个可被 worker 访问的直连段 IP (--pp-listen)，不能默认 0.0.0.0"
    exit 1
  fi

  # 模型缺失/非法**响亮失败** —— ds4 不做静默回退 (否则"看似加载成功实则错")。
  if [ -z "${MODEL_PATH:-}" ] || [ ! -f "$MODEL_PATH" ]; then
    log "ERROR: ds4 MODEL_PATH 未设或文件不存在: '${MODEL_PATH:-<空>}' (conf=$DS4_CONF) —— 拒绝加载。"
    exit 1
  fi
  # 只在本进程注入库路径 (不落盘、不改全局)。
  export LD_LIBRARY_PATH="${ROCM_PATH}/lib/rocm_sysdeps/lib:${ROCM_PATH}/lib"
  # ★ 日志目录必须**可被调用用户写**: 进程以服务用户(scott-lau)跑, 而 sudo mkdir 产出的是
  #   root:root 755 ⇒ 重定向失败会让进程**连启动都起不来**。2026-09-28 首跑实测踩到:
  #   日志文件根本没生成, 外在表现只是 "worker 未存活 (立即退出?)" —— 极易误判成 ds4 自身问题。
  #   故: 建完即 chown 给调用者; 仍不可写则退到用户目录 (WARN 响亮报出, 不静默)。
  sudo mkdir -p "$DS4_LOG_DIR" 2>/dev/null || mkdir -p "$DS4_LOG_DIR" 2>/dev/null || true
  [ -w "$DS4_LOG_DIR" ] || sudo chown "$(id -u):$(id -g)" "$DS4_LOG_DIR" 2>/dev/null || true
  if [ ! -w "$DS4_LOG_DIR" ]; then
    log "WARN: ${DS4_LOG_DIR} 不可写 → ds4 日志改落 ${HOME}/ds4-logs"
    DS4_LOG_DIR="${HOME}/ds4-logs"; mkdir -p "$DS4_LOG_DIR"
  fi
  DS4_LOG="${DS4_LOG_DIR}/${ALIAS}.${PP_ROLE:-single}.log"

  case "$PP_ROLE" in
    worker)
      log "ds4 worker: 起 ds4 --role worker (layers='${PP_LAYERS:-}' coordinator='${PP_COORDINATOR:-}' port ${PP_PORT}) ..."
      nohup "${DS4_HOME}/ds4" --rocm --role worker --layers "${PP_LAYERS:-}" \
        --coordinator "${PP_COORDINATOR:-}" "${PP_PORT}" \
        -m "$MODEL_PATH" -c "$CTX" \
        > "$DS4_LOG" 2>&1 &
      ;;
    coordinator)
      log "ds4 coordinator: 起 ds4-server --role coordinator (layers='${PP_LAYERS:-}' listen='${PP_LISTEN}' pp=${PP_PORT} http=${HTTP_PORT}) ..."
      nohup "${DS4_HOME}/ds4-server" --rocm --role coordinator --layers "${PP_LAYERS:-}" \
        --listen "${PP_LISTEN}" "${PP_PORT}" \
        -m "$MODEL_PATH" -c "$CTX" --host 127.0.0.1 --port "$HTTP_PORT" \
        > "$DS4_LOG" 2>&1 &
      ;;
    *)
      log "ds4 单机: 起 ds4-server (port ${HTTP_PORT} ctx ${CTX}; PP listen 未显式传参, 引擎默认) ..."
      nohup "${DS4_HOME}/ds4-server" --rocm -m "$MODEL_PATH" -c "$CTX" \
        --host 127.0.0.1 --port "$HTTP_PORT" \
        > "$DS4_LOG" 2>&1 &
      ;;
  esac
  DS4_PID=$!
  echo "$DS4_PID" >> "$DS4_LOG" 2>/dev/null || true   # pid 落日志便于排查
  log "ds4 launched pid=${DS4_PID} role=${PP_ROLE:-single} log=$DS4_LOG"

  if [ "$PP_ROLE" = "worker" ]; then
    # ★ worker **没有 HTTP 面** (它只等服务端连入) ⇒ 不能用 /v1/models 探活。
    #   就绪信号 = 日志出现 'distributed worker:' 行 —— 该行只在**模型加载完 + 后端初始化完 +
    #   层片切好**之后才打印, 是比 "进程还活着" 强得多的**真就绪**判据
    #   ('进程存活' 只说明没崩, 可能是加载失败前的假绿)。同时监视进程存活: 一旦退出立即报错。
    #   ★ 注意进程判据的模式是 '[d]s4 .*--role' (非 '[d]s4 --role') —— 见 [3] 段的同因注释。
    log "ds4 worker 无 HTTP 面, 按日志就绪标记判定 (最多 120s) ..."
    _DS4_READY=""
    for i in $(seq 1 60); do
      if grep -q 'distributed worker:' "$DS4_LOG" 2>/dev/null; then _DS4_READY=1; break; fi
      kill -0 "$DS4_PID" 2>/dev/null || break
      sleep 2
    done
    if [ -n "$_DS4_READY" ]; then
      log "READY ✓ (ds4 worker ${ALIAS}; pid=${DS4_PID}, 已加载层片, 等 coordinator 连入)"
      exit 0
    fi
    log "ERROR: ds4 worker 未就绪/已退出 (未见到 'distributed worker:' 日志) — tail $DS4_LOG 排查"
    tail -n 20 "$DS4_LOG" 2>/dev/null || true
    exit 1
  fi

  # 单机 / coordinator: 有 HTTP 面 ⇒ 轮询 /v1/models (★ ds4 **无 /health 端点**, 最多 60×2s)。
  for i in $(seq 1 60); do
    if curl -sf --max-time 2 "http://127.0.0.1:${HTTP_PORT}/v1/models" >/dev/null 2>&1; then
      log "READY ✓ :${HTTP_PORT} (ds4 ${ALIAS} role=${PP_ROLE:-single})"
      exit 0
    fi
    # 进程若已退出 (缺 so / 模型不支持等) ⇒ 不必等满 120s
    if ! kill -0 "$DS4_PID" 2>/dev/null; then
      log "ERROR: ds4 进程已退出 (role=${PP_ROLE:-single}) — tail $DS4_LOG 排查"
      tail -n 20 "$DS4_LOG" 2>/dev/null || true
      exit 1
    fi
    sleep 2
  done
  log "ERROR: ds4 健康检查超时 (:${HTTP_PORT}/v1/models) — tail $DS4_LOG 排查"
  exit 1
fi

# ---- [5] RPC 节点 (分布式) ----
# ⚠ 两个真因 (2026-09-15 实测定位, 缺一都会"名义双机、实际单机"):
#
# 真因① **身份错了**: infer-load 由 `sudo` 拉起 ⇒ 以 **root** 执行 ssh, 而 root 的
#   ~/.ssh 里没有到各 worker 的密钥。旧实现 `ssh -o BatchMode=yes <A> systemctl start`
#   因此认证失败; 又因本脚本是 `set -uo pipefail`(**当时没有 -e**), 失败**不中断也不报错**
#   → 节点从没起来 → master 侧的 rpc-nodes 探测为空 → 回退单机。
#   全程只有一个 stderr 的 warn, /health 照样通过 —— 加载看起来完全"成功"。
#   ⇒ RPC 节点必须用**持有密钥的服务用户**来起 (`sudo -u <user> rpc-nodes ...`)。
#   ★ 2026-10-28（review-p2-big #5）：prologue 已补 `-e`；且下面 `if … fi || { exit 7; }`
#     把"起节点失败"变成**显式出口**（该 if 复合在逻辑或列表里 ⇒ -e 不介入，由 `exit 7` 收口）。
#
# 真因② **没等端口**: master 侧 `RPC_TARGET=auto` 的展开是**单次探测、无重试**,
#   端口若还没监听, /dev/tcp 连接被**立即拒绝**(不是等 2s 超时) → 同样落空回退。
#   ⇒ 用 `rpc-nodes --start`: 它自带 `wait_port`(15×2s); 未显式指定 worker 时按 nodes.env
#   声明启动**全部**节点 (A + C, 即旧文档的"1 master + 2 worker"); 显式 RPC_TARGET 时只起该 worker。
#
# 另外: 拿不到节点时**不再静默回退**, 而是响亮失败 (exit 7) —— 静默回退正是这类错误
# 长期不可见的根源 (P2-4 路径对比的两条路径就因此都跑成了单机)。
if [ -n "${RPC_TARGET:-}" ]; then
  RPCCMD="$(command -v rpc-nodes || echo /usr/local/bin/rpc-nodes)"
  # ★ 2026-10-29（O-181）：身份解析必须与 infer-unload 同源 —— root 下 `id -un` = root，
  #   root 的 ~/.ssh 无密钥/无 known_hosts ⇒ 起节点必然失败，且错误会被 `|| { exit 7; }` 收成
  #   一句"节点未就绪"，看不出是身份问题。顺序：显式 RPC_USER > nodes.env > 首个持钥用户 > 当前用户。
  NODES_ENV_F="${NODES_ENV:-/etc/llama-instances/nodes.env}"
  if [ -z "${RPC_USER:-}" ] && [ -f "$NODES_ENV_F" ]; then
    RPC_USER="$(sed -n 's/^RPC_USER=//p' "$NODES_ENV_F" 2>/dev/null | tail -1 | tr -d '"' || true)"
  fi
  if [ -z "${RPC_USER:-}" ] && [ "$(id -u)" = "0" ]; then
    for _ru in $(getent passwd 2>/dev/null | awk -F: '$3>=1000 && $3<65534 {print $1}' || true); do
      _ru_home="$(getent passwd "$_ru" 2>/dev/null | awk -F: '{print $6}' || true)"
      [ -n "$_ru_home" ] || continue
      if [ -r "${_ru_home}/.ssh/id_ed25519" ] || [ -r "${_ru_home}/.ssh/id_rsa" ]; then
        RPC_USER="$_ru"; break
      fi
    done
  fi
  [ -n "${RPC_USER:-}" ] || RPC_USER="$(id -un)"
  log "worker 通道用户: ${RPC_USER}（root 无节点密钥；须能读 ~/.ssh/id_*）"
  # 2026-10-22: 显式 RPC_TARGET ⇒ 只起该 worker（起 = 用）。auto 保持旧语义（起全部声明节点）。
  RPC_FILTER=""
  [ "$RPC_TARGET" = "auto" ] || RPC_FILTER="$RPC_TARGET"
  log "起 RPC 节点 (${RPCCMD} --start ${ALIAS} ${RPC_FILTER:+(仅 ${RPC_FILTER})}, 服务用户身份 + 自带等端口)..."
  if [ "$(id -u)" = "0" ]; then
    RPC_ALIVE="$(sudo -u "$RPC_USER" "$RPCCMD" --start "${ALIAS}" ${RPC_FILTER:+"$RPC_FILTER"})"
  else
    RPC_ALIVE="$("$RPCCMD" --start "${ALIAS}" ${RPC_FILTER:+"$RPC_FILTER"})"
  fi || {
    log "ERROR: RPC 节点未能就绪 —— 拒绝静默回退单机"
    log "       排查: (a) 是否以服务用户身份 ssh (root 无节点密钥)"
    log "             (b) /etc/llama-instances/nodes.env 的 RPC_NODES 是否可达"
    log "             (c) 各站 systemctl status rpc-server@${ALIAS}"
    exit 7
  }
  log "RPC 节点就绪: ${RPC_ALIVE}"
fi

# ---- [6a] unsloth 后端 (默认) ----
if [ "$BACKEND" = "unsloth" ]; then
  log "unsloth 后端: 起 unsloth studio gpt-oss(${ALIAS}) port ${PORT_NUM} ctx ${CTX:-32768}..."
  # 2026-09-17 (遗留清理): 原此处为
  #   export LLAMA_SERVER_PATH="${LLAMA_SERVER_PATH:-/home/scott-lau/llama.cpp-vulkan-b10715/llama-server}"
  # 该缺省路径的目录已于 2026-09-08 清除, 且 A/B 站 .bashrc/.profile 也 export 了同一死路径
  # => 典型"pin 到不存在路径": studio 会静默落到自带引擎(故当时无可见故障), 但一旦有人重建该目录,
  #    A/B(有 profile export)与 C(无)会**静默分叉**到不同引擎。故不再注入; 调用方仍可显式 export 覆盖。
  # O-25 在线实测顺带修复(2026-09-12): unsloth llama.cpp 已从 Vulkan 切 ROCm 后端,
  # 设备名 Vulkan0 -> ROCm0 (6 台 AMD 8060S 均实测 `--list-devices` = ROCm0)。硬编码 Vulkan0 会导致必然加载失败。
  # 2026-09-22 二修 (方案A 升级试点暴露): 该后端**不是恒定的** —— `unsloth studio update` 每次都按硬件
  #   探测重选后端 bundle, 未显式 pin 时以探测结果为准 (作者级 help: "--llama-backend ... record the
  #   choice, so later updates keep it instead of re-detecting"; 存储的选择是 advisory)。
  #   A 站 2026-09-22 实测: 探测报 has_rocm=false => 自动装 linux-vulkan-x64 包 => 设备名翻回 Vulkan0,
  #   于是"硬编码 ROCm0"**第二次**成为必然失败的原因(上一次是反向)。
  #   => 不再硬编码设备名, 改为按引擎自身 `--list-devices` **实测选取** (ROCm 优先, 维持既定形态
  #      "单站=HIP"; 无 ROCm 时退 Vulkan/CUDA/首个)。探测结果进日志, 使"翻转过"与"没翻转"可区分。
  # env INFER_DEVICE 仍为最高优先(显式覆盖, 如临时 vllm/其它设备名)。
  if [ -z "${INFER_DEVICE:-}" ]; then
    _ENGINE="$HOME/.unsloth/llama.cpp/build/bin/llama-server"
    _DEVS=$(timeout 20 "$_ENGINE" --list-devices 2>&1 \
              | sed -n 's/^[[:space:]]*\([A-Za-z][A-Za-z0-9]*[0-9]\):[[:space:]].*/\1/p' \
              | sort -u | tr '\n' ' ')
    INFER_DEVICE=""
    for _pref in ROCm Vulkan CUDA; do
      _hit=$(printf '%s\n' $_DEVS | grep -m1 "^${_pref}[0-9]") || true
      if [ -n "$_hit" ]; then INFER_DEVICE="$_hit"; break; fi
    done
    [ -n "$INFER_DEVICE" ] || INFER_DEVICE=$(printf '%s\n' $_DEVS | head -1)
    log "引擎设备探测: 候选=[${_DEVS}] 选中=${INFER_DEVICE:-无}"
  fi
  DEVICE="${INFER_DEVICE:-ROCm0}"
  # ── STUDIO_FLAGS 守卫 (2026-10-21) ──────────────────────────────────────
  # 只允许**追加式**调优旗标。CTX 与 flash-attn 由本 wrapper 拥有:
  #   · 重复 `-c` 是 llama.cpp 的硬失败面;
  #   · 同一参数两处真值 (conf 的 CTX vs STUDIO_FLAGS 里的 --ctx-size) 会让"实际生效值"不可判。
  # 命中即响亮失败 —— 不静默丢弃 (否则用户以为调参生效、实际没有)。
  case " ${STUDIO_FLAGS:-} " in
    *" -c "*|*" --ctx-size "*|*" -c="*|*" --ctx-size="*|*" -fa "*|*" --flash-attn "*|*" --flash-attn="*)
      log "ERR: STUDIO_FLAGS 含禁用项 (-c/--ctx-size/-fa/--flash-attn 由 wrapper 拥有): ${STUDIO_FLAGS}"
      exit 1 ;;
  esac
  cd "$HOME"
  UN_LOG="$HOME/.unsloth/run-${ALIAS}.log"
  nohup "$HOME/.local/bin/unsloth" studio run --model "$MODEL_PATH" \
    --port "${PORT_NUM}" --api-only \
    --flash-attn on --no-context-shift -c "${CTX:-32768}" --device "$DEVICE" --kv-unified \
    --cache-type-k q8_0 --cache-type-v q8_0 ${STUDIO_FLAGS:-} \
    > "$UN_LOG" 2>&1 &
  UN_PID=$!
  log "unsloth launched pid=${UN_PID} log=$UN_LOG"
  # ★ 2026-10-29（O-179 §5-5）：两轮等待循环都要能回答"它是不是已经死了"。
  #   判据要两条都成立才算死：父 pid 不在 **且** 没有 `unsloth studio run` 在跑
  #   —— studio 若 fork/重执行，父 pid 会变，只 `kill -0` 会误报死亡。
  _un_dead() {
    ! kill -0 "$UN_PID" 2>/dev/null && ! pgrep -f '[u]nsloth studio run' >/dev/null 2>&1
  }
  # unsloth 可能改写 --port (占用则自动+1); 从日志解析实际端口
  ACT_PORT="$PORT_NUM"
  # ★ 端口解析循环也要判死：实测（2026-10-29）`MODEL_PATH` 不存在时 studio 5s 内就退出，
  #   旧实现仍把 40×3s 走满（白等 2min）才进健康检查。
  for i in $(seq 1 40); do
    P=$(grep -oE "running at http://127.0.0.1:[0-9]+" "$UN_LOG" | head -1 | grep -oE "[0-9]+$" || true)
    if [ -n "$P" ]; then ACT_PORT="$P"; break; fi
    if _un_dead; then
      log "ERROR: unsloth studio 已退出（端口未就绪，pid=${UN_PID}）—— 不再空等"
      tail -n 20 "$UN_LOG" 2>/dev/null | sed 's/^/[infer-load]   /' || true
      exit 1
    fi
    sleep 3
  done
  log "unsloth 实际端口: ${ACT_PORT}"
  # (b) 权限收紧 (2026-09-16): studio 把引擎 key 明文写进 $UN_LOG (实测每次 4 处), 而默认
  # umask 022 下是 775 目录 / 664 日志 ⇒ **组与其他用户可读**, 且历史日志无限累积 (实测三站曾
  # 累积 16 个历史 key / 64 处明文)。"日志含 key"是设计使然(上面正是从日志 grep 取 key), 消除
  # 不掉, 故只能收紧权限: 目录 700 + 日志 600。
  chmod 700 "$HOME/.unsloth" 2>/dev/null || true
  [ -f "$UN_LOG" ] && chmod 600 "$UN_LOG" 2>/dev/null || true
  # 解析 API Key (unsloth 每次重启重铸; /v1/models 需认证)
  UN_KEY=$(grep -oE "sk-unsloth-[a-f0-9]+" "$UN_LOG" | tail -1 || true)
  # C2 (2026-09-16): 把 studio 本次重铸的 key 落盘。引擎面固定 :8080 后, opencode 的
  # {file:~/.config/rpc/unsloth.key} 与 claude 的 apiKeyHelper 都读它 —— 这是"端口固定"之后
  # 唯一需要每次刷新的东西, 也是 claude 路径此前坏掉的**真因** (key 陈旧, 不是端口不对)。
  if [ -n "$UN_KEY" ]; then
    mkdir -p "$HOME/.config/rpc"
    printf '%s\n' "$UN_KEY" > "$HOME/.config/rpc/unsloth.key"
    chmod 600 "$HOME/.config/rpc/unsloth.key"
    log "API Key 已落盘 -> ~/.config/rpc/unsloth.key"
  fi
  # 等就绪: /v1/models (unsloth, 带认证) 确认模型可服务
  # ★ 2026-10-29（O-179 §5-5）：**不能**再写成「裸 curl + `if [ $? -eq 0 ]`」——
  #   本脚本是 `set -euo pipefail`，studio 尚未监听时首次 curl 返回 7
  #   （CURLE_COULDNT_CONNECT）⇒ **整个脚本立即终止**，没有任何 ERROR 输出，
  #   退出码 7 还会被误读成 [5] 的"RPC 节点失败"。实测（C 站 15:10）复现。
  for i in $(seq 1 120); do
    _ok=1
    if [ -n "$UN_KEY" ]; then
      curl -sf --max-time 2 -H "Authorization: Bearer ${UN_KEY}" "http://127.0.0.1:${ACT_PORT}/v1/models" >/dev/null 2>&1 || _ok=0
    else
      curl -sf --max-time 2 "http://127.0.0.1:${ACT_PORT}/v1/models" >/dev/null 2>&1 || _ok=0
    fi
    if [ "$_ok" = "1" ]; then
      log "READY ✓ :${ACT_PORT} (unsloth ${ALIAS})"
      # 2026-09-16 (a): 原为 `log "API Key: $UN_KEY"` —— 会把引擎 key 明文带进调用方 stdout
      # (cluster.py load / 会话 transcript / 任何 CI 控制台日志)。改为只打长度 + sha8 指纹,
      # 保留"同一把 key"的可关联性而不泄露材料。
      if [ -n "$UN_KEY" ]; then log "API Key ok (len=${#UN_KEY} sha8=$(printf '%s' "$UN_KEY" | sha256sum | cut -c1-8))"; fi
      exit 0
    fi
    # ★ 2026-10-29（O-179 §5-5）：进程已死就别再空等 —— 旧实现只轮询 /v1/models，
    #   studio 若因模型/引擎路径不对而秒退，会白等满 6min 再报"健康检查超时"，
    #   真因（日志里的 ERROR 行）被埋在 120 轮之后。
    if _un_dead; then
      log "ERROR: unsloth studio 已退出 (pid=${UN_PID}) —— 不再空等就绪"
      tail -n 20 "$UN_LOG" 2>/dev/null | sed 's/^/[infer-load]   /' || true
      exit 1
    fi
    sleep 3
  done
  log "ERROR: unsloth 健康检查超时 — tail $UN_LOG 排查"
  exit 1
fi

# ---- [6b] B 站 llama-server (systemd 回退) ----
log "B 站起 llama-server@${ALIAS} (port ${PORT_NUM})..."
sudo systemctl start "llama-server@${ALIAS}"

# ---- [7] 健康检查 ----
# 预算 15min (原 6min) —— 2026-09-29 实测: 146 GiB 级模型**冷启动**(首跑, worker 侧 rpccache 全空,
#   要跨机推全部张量 + 落盘) 三机形态实测 **9 分 07 秒**; 双机(手册记 5min17s)也逼近旧上限。
#   旧上限的后果不是"多等一会", 而是**统一入口把成功的加载报成失败**
#   (`[cluster] 加载失败 (rc=1)`, 而 head 一分钟后就绪、decode 正常) —— 这正是"整合进统一入口"
#   最容易被误判成"跑不通"的形态。(V4-Flash 双机有 A 站 rpccache 命中, 只需 ~3min, 故旧值长期没暴露。)
for i in $(seq 1 300); do
  if curl -sf --max-time 2 "http://127.0.0.1:${PORT_NUM}/health" >/dev/null 2>&1; then
    log "READY ✓ :${PORT_NUM} (llama-server@${ALIAS})"
    exit 0
  fi
  # ★ 2026-10-29（O-179 §5-5）：单元已 failed ⇒ 立刻报真因，不再空等满 15min。
  #   实测（G1 首跑）：conf 的 LLAMA_SERVER_BIN 指向不存在的引擎 ⇒ 单元 exit 127 秒退，
  #   旧循环仍 curl 300 次，最后只说"健康检查超时" —— 真因（ExecMainStatus=127）在 journal 里。
  #   `is-failed` 退出码 0 = 已 failed；单元不存在/正在启动都非 0 ⇒ 不会误判。
  if sudo systemctl is-failed --quiet "llama-server@${ALIAS}" >/dev/null 2>&1; then
    log "ERROR: llama-server@${ALIAS} 已 failed（不再空等）—— 退出码与最近日志:"
    sudo systemctl show -p Result -p ExecMainStatus "llama-server@${ALIAS}" 2>/dev/null \
      | sed 's/^/[infer-load]   /' || true
    sudo journalctl -u "llama-server@${ALIAS}" -n 20 --no-pager 2>/dev/null \
      | sed 's/^/[infer-load]   /' || true
    log "       提示: ExecMainStatus=127 多为引擎路径悬空 —— 可用 --engine <变体|绝对路径> 覆盖"
    exit 1
  fi
  sleep 3
done
log "ERROR: 健康检查 15min 超时 — journalctl -u llama-server@${ALIAS} 排查"
exit 1