# cluster-ttl 配置模板 (2026-09-15, 方案 v2 P2-5) — 引擎空闲 TTL 自动卸载
# 部署位置: /etc/llama-instances/ttl.env  (与 nodes.env 同处: 集群级声明文件)
# ⚠ 改完**无需重启任何服务**: cluster-ttl 每次运行都重新读本文件。
#
# 与"零自加载"方针并存: TTL 只**释放**已加载的资源, 从不自动加载任何模型。

# 总开关。0 = 关 (默认): cluster-ttl 降级为"演练" —— 照常判定并打印结论, 但绝不执行卸载。
TTL_ENABLED=0

# 空闲多少秒后卸载 (语义同 llama-swap 的 ttl)。1800 = 30min。
TTL_IDLE_SECONDS=1800

# 置 1 = 即使 TTL_ENABLED=1 也只演练不卸载 (正式开启前先观察一轮用)。
TTL_DRY_RUN=0
