#!/bin/bash
# load-gate 最终版 (部署用) — B/C 站也是同构脚本
# 用法: load-gate <需要GB> [host...] ; 默认本机
# ssh 纪律 (2026-09-22 统一): 对 peer 的每个 ssh 都必须带 `-o BatchMode=yes`（并显式
#   `-o ConnectTimeout=`）。理由: 认证异常时 OpenSSH 会**弹口令阻塞等 stdin** ⇒ 在本脚本里表现
#   为"卡住"而非"失败"（实测挂起 >90s）。加了之后，认证/网络异常会**快速返回空值** ⇒ 直接落到下面
#   既有的 `[ABORT] host $h 不可达` 分支（fail-closed 语义本就存在，此处只是把"卡住"去掉）。
set +e
NEED="${1:?用法: load-gate <需要GB> [host ...]}"
HOSTS=("${@:2}")
[ ${#HOSTS[@]} -eq 0 ] && HOSTS=("localhost")

gethost_facts() {
  local h="$1"
  if [ "$h" = "localhost" ]; then
    total=$(awk '/MemTotal/{printf "%d", $2/1024}' /proc/meminfo)
    avail=$(awk '/MemAvailable/{printf "%d", $2/1024}' /proc/meminfo)
    used=$(( total - avail ))
    rssm=$(ps -eo rss,comm | grep -E 'llama-server|ggml-rpc-server|llama-cli' | awk '{s+=$1} END{printf "%d", s/1024}')
    load1=$(cut -d' ' -f1 /proc/loadavg)
    # docker 容器占用 (ADR-0014 V4): 容器内存**已**计入上面的 used/avail, 但 rssm 的进程名
    #   白名单看不见它们 ⇒ 这里显式取数, 让"看不见"变成"看得见"(容器内存取不到则记 0)。
    dockm=$(cat /sys/fs/cgroup/system.slice/docker-*.scope/memory.current 2>/dev/null | awk '{s+=$1} END{printf "%d", s/1048576}')
    dockn=$(docker ps -q 2>/dev/null | wc -l | tr -d ' ')
  else
    total=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$h" "awk '/MemTotal/{printf \"%d\", \$2/1024}' /proc/meminfo" 2>/dev/null)
    avail=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$h" "awk '/MemAvailable/{printf \"%d\", \$2/1024}' /proc/meminfo" 2>/dev/null)
    rssm=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$h" "ps -eo rss,comm | grep -E 'llama-server|ggml-rpc-server|llama-cli' | awk '{s+=\$1} END{printf \"%d\", s/1024}'" 2>/dev/null)
    load1=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$h" "cut -d' ' -f1 /proc/loadavg" 2>/dev/null)
    dockm=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$h" "cat /sys/fs/cgroup/system.slice/docker-*.scope/memory.current 2>/dev/null | awk '{s+=\$1} END{printf \"%d\", s/1048576}'" 2>/dev/null)
    dockn=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$h" "docker ps -q 2>/dev/null | wc -l" 2>/dev/null)
    used=$(( total - avail ))
  fi
  [ -z "$rssm" ] && rssm=0
  [ -z "$dockm" ] && dockm=0
  [ -z "$dockn" ] && dockn=0
  [ -z "$total" ] && { echo "  [ABORT] host $h 不可达" >&2; exit 1; }
  echo "$total $avail $used $rssm $load1 $dockm $dockn"
}

need_mb=$(( NEED * 1024 ))
saf_mb=$(( 12 * 1024 ))
for h in "${HOSTS[@]}"; do
  facts=$(gethost_facts "$h") || exit 1
  read -r total avail used rssm load1 dockm dockn <<< "$facts"
  echo "--- [$h] need=${NEED}G avail=$((avail/1024))G used=$((used/1024))G existing_rss=$((rssm/1024))G docker=${dockn}容器/$((dockm/1024))G load1=$load1 total=$((total/1024))G"
  if [ $(( used + need_mb + saf_mb )) -gt "$total" ]; then
    echo "  [ABORT] 加法超限: used($((used/1024))G)+need(${NEED}G)+12G > total($((total/1024))G)" >&2
    exit 1
  fi
  if [ "$avail" -lt "$(( need_mb + saf_mb ))" ]; then
    echo "  [ABORT] avail 不足: $((avail/1024))G < ${NEED}G+12G" >&2
    exit 1
  fi
  if [ $(( rssm + need_mb + saf_mb )) -gt "$total" ]; then
    echo "  [ABORT] 已有 llama RSS $((rssm/1024))G + need ${NEED}G + 12G > total $((total/1024))G — 先卸旧实例" >&2
    exit 1
  fi
  if [ -n "$load1" ] && awk -v l="$load1" 'BEGIN{exit !(l>8)}'; then
    echo "  [WARN] loadavg1=$load1 > 8"
  fi
  # 容器占用是"**看得见**"而非静默: 三闸的算术用的是 meminfo(容器内存已计入 used/avail),
  #   但下面 rssm 那条"已有实例"判据按**进程名**取数 ⇒ 看不见容器 ⇒ 这里显式提示(不改三闸算术)。
  if [ "$dockn" -gt 0 ] && [ "$dockm" -eq 0 ]; then
    echo "  [WARN] 有 $dockn 个运行中容器, 但未取到容器内存 (cgroup 路径可能不同) —— '已有实例'判据看不见它们" >&2
  elif [ "$dockn" -gt 0 ]; then
    echo "  [WARN] 有 $dockn 个运行中容器占 $((dockm/1024))G —— 已计入 used/avail(三闸有效); '已有实例'判据按进程名取数看不见它们" >&2
  fi
  echo "  [OK]"
done
echo "[load-gate] ALL PASS: ${NEED}G 可加载"