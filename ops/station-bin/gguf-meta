#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""gguf-meta — 读 GGUF 文件头元数据, 输出 JSON。

用法:
    gguf-meta <model.gguf> [<model2.gguf> ...]
    gguf-meta --key block_count <model.gguf>

为什么自带解析(不装 gguf-py): 项目坚持零外部依赖; 而 GGUF header 格式稳定且简单
(magic + version + counts + KV 对), **只读头部**即可拿到架构参数(层数/KV heads/
head_dim/原生 ctx/SSM 配置), 无需读张量数据 → 秒级返回。

供 load-gate / infer-load / 主控预估 (cluster.py estimate) 复用 —— 单一事实源。
"""
import json
import struct
import sys

# GGUF value type 枚举
(T_UINT8, T_INT8, T_UINT16, T_INT16, T_UINT32, T_INT32, T_FLOAT32,
 T_BOOL, T_STRING, T_ARRAY, T_UINT64, T_INT64, T_FLOAT64) = range(13)

_FMT = {T_UINT8: "<B", T_INT8: "<b", T_UINT16: "<H", T_INT16: "<h",
        T_UINT32: "<I", T_INT32: "<i", T_FLOAT32: "<f", T_BOOL: "<?",
        T_UINT64: "<Q", T_INT64: "<q", T_FLOAT64: "<d"}

# 大数组(tokenizer 词表等)只保留前若干项, 否则解析慢且输出巨大
_ARR_KEEP = 8


def _r_str(f):
    n = struct.unpack("<Q", f.read(8))[0]
    return f.read(n).decode("utf-8", "replace")


def _r_val(f, t):
    if t == T_STRING:
        return _r_str(f)
    if t == T_ARRAY:
        et = struct.unpack("<I", f.read(4))[0]
        n = struct.unpack("<Q", f.read(8))[0]
        if et == T_STRING and n > _ARR_KEEP:
            head = [_r_str(f) for _ in range(_ARR_KEEP)]
            for _ in range(n - _ARR_KEEP):
                _r_str(f)
            return {"_truncated": True, "_len": n, "_head": head}
        return [_r_val(f, et) for _ in range(n)]
    fmt = _FMT.get(t)
    if not fmt:
        raise ValueError("unknown gguf value type %d" % t)
    return struct.unpack(fmt, f.read(struct.calcsize(fmt)))[0]


def read_meta(path):
    with open(path, "rb") as f:
        if f.read(4) != b"GGUF":
            raise ValueError("not a GGUF file: %s" % path)
        ver = struct.unpack("<I", f.read(4))[0]
        n_tensor = struct.unpack("<Q", f.read(8))[0]
        n_kv = struct.unpack("<Q", f.read(8))[0]
        meta = {}
        for _ in range(n_kv):
            k = _r_str(f)
            vt = struct.unpack("<I", f.read(4))[0]
            meta[k] = _r_val(f, vt)
    return {"version": ver, "tensor_count": n_tensor, "meta": meta}


def summarize(path):
    """把 GGUF 原始 KV 压成预估需要的字段(架构无关的通用取值)。"""
    r = read_meta(path)
    m = r["meta"]
    arch = m.get("general.architecture", "")
    p = (arch + ".") if arch else ""

    def g(*names, default=None):
        for n in names:
            v = m.get(p + n) if p else None
            if v is None:
                v = m.get(n)
            if v is not None:
                return v
        return default

    out = {
        "path": path,
        "gguf_version": r["version"],
        "tensor_count": r["tensor_count"],
        "arch": arch,
        "name": m.get("general.name"),
        "file_type": m.get("general.file_type"),
        "block_count": g("block_count"),
        "head_count": g("attention.head_count"),
        "head_count_kv": g("attention.head_count_kv"),
        "key_length": g("attention.key_length"),
        "value_length": g("attention.value_length"),
        "embedding_length": g("embedding_length"),
        "context_length": g("context_length"),
        "rope_freq_base": g("rope.freq_base"),
        # hybrid SSM/attention (Qwen3.x-Next / Nemotron-H / Mamba 系) 相关
        "ssm_state_size": g("ssm.state_size", "ssm.state_size"),
        "ssm_conv_kernel": g("ssm.conv_kernel"),
        "ssm_inner_size": g("ssm.inner_size"),
        "ssm_group_count": g("ssm.group_count"),
        "full_attention_interval": g("full_attention_interval"),
        "expert_count": g("expert_count"),
        "expert_used_count": g("expert_used_count"),
    }
    return out


def main(argv):
    if not argv:
        print(__doc__)
        return 1
    if argv[0] == "--key":
        if len(argv) < 3:
            print("用法: gguf-meta --key <key> <model.gguf>")
            return 1
        return 0 if print(read_meta(argv[2])["meta"].get(argv[1])) else 0
    results = []
    for p in argv:
        try:
            results.append(summarize(p))
        except Exception as e:
            results.append({"path": p, "error": "%s: %s" % (type(e).__name__, e)})
    print(json.dumps(results[0] if len(results) == 1 else results,
                     ensure_ascii=False, indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
