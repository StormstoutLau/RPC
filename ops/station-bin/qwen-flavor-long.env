# qwen-flavor-long.env - L1 instance-layer preset for complexity route flavor "long"
# Maps to profile long (complexity=long, big docs / large codebase). Full native ctx
# (262144) with thinking ON (froggeric template, reasoning_format=qwen). Thinking is
# COMPRESSED at the L3 prompt layer (agent-cli appends terse-tail) not via an extra
# engine flag, so no unverified --reasoning-budget flag risks a llama-server boot fail.
# Source of truth: ops/station-bin/qwen-flavor-long.env (console/git). Deployed by
# _switch_qwen_flavor(.ps1) in a manual idle-window switch. Not loaded until user triggers.
MODEL_PATH=/data/models/gguf/Jackrong/Qwen3.8-27B-MTP-GGUF/Qwen3.8-27B-MTP-Q8_0.gguf
LLAMA_SERVER_BIN=/home/scott-lau/llama.cpp/build/bin/llama-server
PORT=18080
CTX=262144
THREADS=16
N_CPU_MOE=0
RPC_TARGET=
BACKEND=llama-single
EXTRA_FLAGS="--mmproj /data/models/gguf/Jackrong/Qwen3.8-27B-MTP-GGUF/mmproj-F32.gguf --flash-attn on --device Vulkan0 --spec-type draft-mtp --spec-draft-n-max 5 --parallel 1 --no-context-shift --jinja --chat-template-file /etc/llama-instances/chat-templates/froggeric_qwen.jinja"