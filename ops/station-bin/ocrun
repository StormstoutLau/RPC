#!/usr/bin/env bash
# ============================================================================
# oCrun — opencode run 的可控包装 (D6 agent 标准框架 / 站内)
#
# 为什么需要它: `opencode run` 无默认总超时。模型侧慢时表现为"无反馈挂起",
#   上层脚本既拿不到错误也等不到结果 —— 这是 2026-09-14 暴露的 P1。
#   本包装给每一次尝试加超时, 失败自动落下一档, 让"慢"变成可判定的失败。
#
# 用法 (两种入口都支持):
#   echo "<prompt>" | oCrun [-m 模型] [-t 秒]      # 管道形式 (手册 §2a.4 约定)
#   oCrun [-m 模型] [-t 秒] "<prompt>"            # 位置参数形式
#   OCRUN_CHAIN="模型A 模型B" oCrun "..."          # 覆盖尝试链
#
# 退出码: 0=某档成功 / 1=全链失败 / 2=用法错误
#
# 注 (2026-09-14 复测): 手册 §2a.4 铁律 2 记「位置参数形式在 1.18.25 会挂死」。
#   本轮以同一模型各跑 4 次复测: 位置参数 4/4 成功、管道形式 2/4 成功 ——
#   **未能复现该铁律**, 两种形式都呈间歇性慢, 形式不是决定性变量。故本脚本
#   实现取管道形式 (与手册约定一致), 但两种入口都接受, 不把形式当硬约束。
# 设计: docs/research/2026-09-14_暴露问题调研.md §1/§4
# ============================================================================
set -u

# 尝试链 (空格分隔), 顺序即优先级
# OpenRouter 段按 secrets/openrouter.conf 的 harness_priority 镜像 (2026-09-14 用户指定序),
# 该键是权威真值; 改动时三处同步 (本脚本 / 站内 opencode.jsonc / 调研报告 §7)。
OCRUN_CHAIN_DEFAULT="opencode/nemotron-3.5-lightning-free \
openrouter/thinkingmachines/inkling:free \
openrouter/nvidia/nemotron-3-ultra-550b-a55b:free \
openrouter/thinkingmachines/inkling-small:free \
openrouter/nvidia/nemotron-3-super-120b-a12b:free \
openrouter/poolside/laguna-s-2.1:free \
local/main"
: "${OCRUN_CHAIN:=$OCRUN_CHAIN_DEFAULT}"
: "${OCRUN_TIMEOUT:=120}"

T="$OCRUN_TIMEOUT"
MODEL=""
ARGS=()

while [ $# -gt 0 ]; do
  case "$1" in
    -m|--model)   MODEL="${2:-}"; shift 2 ;;
    -t|--timeout) T="${2:-}";     shift 2 ;;
    -h|--help)    sed -n '2,20p' "$0"; exit 0 ;;
    *)            ARGS+=("$1"); shift ;;
  esac
done

# 提示词: 优先取位置参数; 无参数则读 stdin (只读一次, 各档复用)
PROMPT=""
if [ ${#ARGS[@]} -gt 0 ]; then
  PROMPT="${ARGS[*]}"
elif [ ! -t 0 ]; then
  PROMPT="$(cat)"
fi

if [ -z "${PROMPT//[[:space:]]/}" ]; then
  echo "用法: echo \"<prompt>\" | oCrun [-m 模型] [-t 秒]   或   oCrun [-m 模型] \"<prompt>\"" >&2
  exit 2
fi

[ -n "$MODEL" ] && CHAIN="$MODEL" || CHAIN="$OCRUN_CHAIN"

i=0
for m in $CHAIN; do
  i=$((i + 1))
  echo "[oCrun] ($i) 尝试 $m  (timeout ${T}s)" >&2
  # 先取 rc: if 无 else 时语句自身返回 0, 会覆盖 $? (实测踩过)
  printf '%s\n' "$PROMPT" | timeout "$T" opencode run -m "$m"
  rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "[oCrun] OK via $m" >&2
    exit 0
  fi
  if [ "$rc" -eq 124 ]; then
    echo "[oCrun] ($i) 超时未完成 (rc=124) — 落下一档" >&2
  else
    echo "[oCrun] ($i) 失败 (rc=$rc) — 落下一档" >&2
  fi
done

echo "[oCrun] 全链失败 ($i 档已试尽)。可显式指定: oCrun -m <模型> ..." >&2
exit 1
